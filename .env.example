# Copia este archivo a .env y cambia los valores marcados.

# Contraseña de la base del banco (cámbiala).
BANK_DB_PASSWORD=cambiar-esta-clave

# Puerto del host para la web app y la API.
BANK_HOST_PORT=8086

# URL pública del banco: la que va dentro de los QR y la que abre el celular.
# Vacía = se arma con cada petición: sirve en localhost y detrás de un túnel; si la
# petición llega por la red interna (http://banco:8080) se usa http://localhost:BANK_HOST_PORT.
# Ponla fija cuando un integrador crea QR por la red interna y se pagan desde un
# celular por un túnel. Ej.: BANK_PUBLIC_URL=https://xxxx.trycloudflare.com
BANK_PUBLIC_URL=

# Permite pagar por API sin la app: POST /api/v1/sandbox/qr/{id}/pay
BANK_SANDBOX=true

# Saldo con el que nace cada cuenta nueva.
BANK_INITIAL_BALANCE=1000.00

# Clientes demo (PIN 123456): 7000001 Rosa, 7000002 Juan (Bs 50), 7000003 Luis, 7000004 Carla.
BANK_SEED_DEMO=true

# Opcional: clave de API fija para compartir con otro equipo (cuenta "Comercio Demo",
# C.I. 9000001, PIN 123456). Si la defines, define también el secreto de avisos.
# En la API Market es el authorizationId; el accountId sale en el log al arrancar
# ("clave de API de demostración lista") y no cambia mientras la clave sea la misma.
# Genera valores con: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BANK_SEED_API_KEY=
BANK_SEED_WEBHOOK_SECRET=
# A dónde mandar los avisos firmados de esa clave (opcional).
BANK_SEED_WEBHOOK_URL=

# Firma los tokens de la API Market (mínimo 32 caracteres). Vacía = se genera una al
# arrancar y los tokens emitidos dejan de servir al reiniciar el banco (hay que pedir
# otro, igual que cuando vence). Genera uno con: openssl rand -base64 48
BANK_TOKEN_SECRET=
